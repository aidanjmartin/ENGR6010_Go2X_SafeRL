# Copy to .env (untracked) and fill in. Never commit .env.
# Variables follow ENGR6010_Exam1 .env.example (commit 90150da).
# Robot serial number, from the Unitree app or the label on the robot
GO2_SERIAL=
# Robot IP address on the wired network (192.168.123.0/24), used by WebRTC
GO2_IP=
# Per-device AES-128 key; only needed for firmware 1.1.15 and later. Exam 1 found
# this robot on firmware 1.1.11 to 1.1.14 (data2 = 2), so leave it empty unless that changes.
GO2_AES_KEY=
# Name of this computer's Ethernet interface to the robot (the USB-C adapter), used by DDS
GO2_ETH_IFACE=
